load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    [
        "BUILD.bazel",
        "nix/default.nix",
        "nix/projection.nix",
        "nix/tests/default.nix",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_activation_nixos",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
    ] + all_crate_deps(normal = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_activation_nixos_test_support",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
    ] + all_crate_deps(normal = True, cargo_only = True),
    crate_name = "d2b_provider_activation_nixos",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "d2b_provider_activation_nixos_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_activation_nixos_test_support",
    deps = [
        "//packages/d2b-contracts-broker:d2b_contracts_broker",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)


rust_test(
    name = "reconcile",
    srcs = [
        "tests/reconcile.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_activation_nixos",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "runner",
    srcs = [
        "tests/runner.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_activation_nixos",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_activation_nixos_doc_test",
    crate = "//packages/d2b-provider-activation-nixos:d2b_provider_activation_nixos",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
