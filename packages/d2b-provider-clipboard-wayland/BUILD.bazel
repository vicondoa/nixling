load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    [
        "BUILD.bazel",
        "nix/default.nix",
        "nix/projection.nix",
        "nix/site.nix",
        "nix/tests/default.nix",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_clipboard_wayland",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
        allow_empty = True,
    ),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "d2b-clipd",
    srcs = ["src/bin/d2b-clipd.rs"],
    compile_data = ["Cargo.toml"] + glob(["src/clipd_host/**/*.rs"]),
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_binary(
    name = "d2b-clip-debug",
    srcs = ["src/bin/d2b-clip-debug.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_provider_clipboard_wayland_test_support",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**/*.rs"],
        allow_empty = True,
    ),
    compile_data = ["Cargo.toml"],
    crate_name = "d2b_provider_clipboard_wayland",
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "fd_safety",
    srcs = [
        "tests/fd_safety.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_clipboard_wayland",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "lifecycle",
    srcs = [
        "tests/lifecycle.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_clipboard_wayland",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "provider_behavior",
    srcs = [
        "tests/provider_behavior.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_clipboard_wayland",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "redaction",
    srcs = [
        "tests/redaction.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_clipboard_wayland",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "clipd_host",
    srcs = ["tests/clipd_host.rs"],
    compile_data = [
        "Cargo.toml",
        "src/bin/d2b-clipd.rs",
    ],
    data = [":d2b-clipd"],
    env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    visibility = ["//visibility:public"],
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "clipd_pipe",
    srcs = ["tests/clipd_pipe.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "clipd_host_impl",
    compile_data = ["Cargo.toml"],
    crate = ":d2b-clipd",
    data = [":d2b-clipd"],
    env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    rustc_env = {"CARGO_BIN_EXE_d2b-clipd": "$(rootpath :d2b-clipd)"},
    visibility = ["//visibility:public"],
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_clipboard_wayland_doc_test",
    crate = "//packages/d2b-provider-clipboard-wayland:d2b_provider_clipboard_wayland",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
