load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    [
        "BUILD.bazel",
        "nix/default.nix",
        "nix/niri-vm-borders.nix",
        "nix/projection.nix",
        "nix/ui-colors.nix",
        "nix/tests/default.nix",
    ],
    visibility = ["//visibility:public"],
)

display_wayland_srcs = glob(
    ["src/**/*.rs"],
    exclude = ["src/bin/**/*.rs"],
    allow_empty = True,
)

rust_library(
    name = "d2b_provider_display_wayland",
    srcs = display_wayland_srcs,
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-contracts-control:d2b_contracts_control",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit",
    ] + all_crate_deps(normal = True, cargo_only = True),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "d2b-wayland-proxy",
    srcs = ["src/bin/d2b-wayland-proxy.rs"],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_display_wayland",
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_provider_display_wayland_test_support",
    srcs = display_wayland_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = ["test-support"],
    crate_name = "d2b_provider_display_wayland",
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-contracts-control:d2b_contracts_control",
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-provider-toolkit:d2b_provider_toolkit_test_support",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "lifecycle",
    srcs = [
        "tests/lifecycle.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_display_wayland",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "policy",
    srcs = [
        "tests/policy.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_display_wayland",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "provider_behavior",
    srcs = [
        "tests/provider_behavior.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_display_wayland_test_support",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "redaction",
    srcs = [
        "tests/redaction.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_provider_display_wayland",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "wayland_proxy_impl",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_provider_display_wayland_test_support",
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "wayland_proxy_binary",
    compile_data = [
        "Cargo.toml",
        "src/bin/d2b-wayland-proxy.rs",
    ] + glob(["src/wayland_proxy/**/*.rs"]),
    crate = ":d2b-wayland-proxy",
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_display_wayland_doc_test",
    crate = "//packages/d2b-provider-display-wayland:d2b_provider_display_wayland",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
