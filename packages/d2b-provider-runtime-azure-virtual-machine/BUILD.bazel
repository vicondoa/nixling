load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    ["BUILD.bazel", "nix/default.nix", "nix/tests/default.nix"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_runtime_azure_virtual_machine",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = ["Cargo.toml"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
    ] + all_crate_deps(normal = True, cargo_only = True),
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "bootstrap_hermetic",
    srcs = [
        "tests/bootstrap_hermetic.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_runtime_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "error_redaction",
    srcs = [
        "tests/error_redaction.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_runtime_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "idempotency",
    srcs = [
        "tests/idempotency.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        ":d2b_provider_runtime_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "lifecycle_hermetic",
    srcs = [
        "tests/lifecycle_hermetic.rs",
    ],
    compile_data = ["Cargo.toml"],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts:d2b_contracts",
        ":d2b_provider_runtime_azure_virtual_machine",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "integration/**/*",
            "nix/**/*",
            "README.md",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_provider_runtime_azure_virtual_machine_doc_test",
    crate = "//packages/d2b-provider-runtime-azure-virtual-machine:d2b_provider_runtime_azure_virtual_machine",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
