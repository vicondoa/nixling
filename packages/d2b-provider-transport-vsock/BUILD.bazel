    visibility = ["//visibility:public"],
)

rust_library(
    name = "d2b_provider_transport_vsock",
    srcs = glob(["src/**/*.rs"], allow_empty = True),
    compile_data = [
        "Cargo.toml",
        "//:docs/reference/schemas/v3/providers/transport-vsock.transport-binding.json",  # keep
        "//:tests/golden/runner-shape/vsock-relay-argv-minimal.txt",
