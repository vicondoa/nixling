load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test", "rust_doc_test")

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

d2b_session_unix_srcs = glob(["src/**/*.rs"], allow_empty = True)

rust_library(
    name = "d2b_session_unix",
    srcs = d2b_session_unix_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = [
        "host-socket",
        "native-vsock",
    ],
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-session:d2b_session",
        "@crates//:zeroize",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_library(
    name = "d2b_session_unix_test_support",
    srcs = d2b_session_unix_srcs,
    compile_data = ["Cargo.toml"],
    crate_features = [
        "host-socket",
        "native-vsock",
        "test-support",
    ],
    crate_name = "d2b_session_unix",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        "//packages/d2b-contracts:d2b_contracts_test_support",
        "//packages/d2b-session:d2b_session_test_support",
        "@crates//:zeroize",
    ] + all_crate_deps(normal = True, cargo_only = True),
)

rust_test(
    name = "subject_mapping",
    srcs = ["tests/subject_mapping.rs"],
    compile_data = ["Cargo.toml"],
    crate_features = [
        "host-socket",
        "native-vsock",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_session_unix",
        "//packages/d2b-session:d2b_session",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "unix_session",
    srcs = ["tests/unix_session.rs"],
    compile_data = ["Cargo.toml"],
    crate_features = [
        "host-socket",
        "native-vsock",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session",
        ":d2b_session_unix",
        "//packages/d2b-contracts:d2b_contracts",
        "//packages/d2b-session:d2b_session",
    ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

rust_test(
    name = "d2b_session_unix_test",
    compile_data = ["Cargo.toml"],
    crate = ":d2b_session_unix",
    crate_features = [
        "host-socket",
        "native-vsock",
    ],
    deps = ["//packages/d2b-contracts-resource:d2b_contracts_resource",
        "//packages/d2b-contracts-zone-session:d2b_contracts_zone_session", ] + all_crate_deps(normal = True, normal_dev = True, cargo_only = True),
)

# keep
filegroup(
    name = "cargo_workspace_sources",
    srcs = glob(
        [
            "Cargo.lock",
            "Cargo.toml",
            "benches/**/*.rs",
            "build.rs",
            "examples/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "d2b_session_unix_doc_test",
    crate = "//packages/d2b-session-unix:d2b_session_unix",
)

test_suite(
    name = "all-tests",
    tags = ["-local", "-no-remote-exec"],
)
